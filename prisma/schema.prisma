generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  REVIEWER
  VIEWER
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentStatus {
  QUARANTINED
  SCANNING
  INFECTED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ACCEPTED_RISK
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  memberships    Membership[]
  apiKeys        ApiKey[]
  matters        Matter[]
  auditEvents    AuditEvent[]
  documents      Document[]
  frameworks     Framework[]
  findings       Finding[]
  promptVersions PromptVersion[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  memberships Membership[]
  apiKeys     ApiKey[]
  auditEvents AuditEvent[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  prefix         String       @unique
  tokenHash      String       @unique
  revokedAt      DateTime?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, revokedAt])
}

model Matter {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  classification DataClassification @default(CONFIDENTIAL)
  retentionDays  Int                @default(365)
  legalHold      Boolean            @default(false)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model Document {
  id             String             @id @default(cuid())
  organizationId String
  matterId       String
  filename       String
  classification DataClassification
  status         DocumentStatus     @default(QUARANTINED)
  retentionUntil DateTime
  deletedAt      DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matter         Matter             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, matterId, status])
}

model DocumentVersion {
  id             String          @id @default(cuid())
  documentId     String
  version        Int
  mediaType      String
  sizeBytes      Int
  sha256         String
  objectKey      String          @unique
  pageCount      Int?
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobs           ProcessingJob[]
  chunks         Chunk[]
  extractionRuns ExtractionRun[]
  findings       Finding[]
  createdAt      DateTime        @default(now())

  @@unique([documentId, version])
  @@index([sha256])
}

model PromptVersion {
  id             String          @id @default(cuid())
  organizationId String
  key            String
  version        Int
  template       String
  outputSchema   Json
  active         Boolean         @default(true)
  checksum       String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           ExtractionRun[]
  createdAt      DateTime        @default(now())

  @@unique([organizationId, key, version])
  @@index([organizationId, key, active])
}

model ExtractionRun {
  id                String          @id @default(cuid())
  organizationId    String
  documentVersionId String
  promptVersionId   String
  model             String
  output            Json
  groundingScore    Float
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  promptVersion     PromptVersion   @relation(fields: [promptVersionId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([organizationId, documentVersionId, createdAt])
}

model Framework {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  version        String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls       Control[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name, version])
}

model Control {
  id          String    @id @default(cuid())
  frameworkId String
  code        String
  title       String
  description String
  weight      Float     @default(1)
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@unique([frameworkId, code])
}

model Finding {
  id                String               @id @default(cuid())
  organizationId    String
  matterId          String
  documentVersionId String
  controlId         String
  title             String
  summary           String
  severity          FindingSeverity
  confidence        Float
  riskScore         Float
  status            FindingStatus        @default(OPEN)
  resolutionNote    String?
  resolvedBy        String?
  resolvedAt        DateTime?
  citation          Json
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion      @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  control           Control              @relation(fields: [controlId], references: [id], onDelete: Cascade)
  suggestions       RevisionSuggestion[]
  evidenceLinks     EvidenceLink[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId, matterId, status])
}

model EvidenceLink {
  id        String   @id @default(cuid())
  findingId String
  chunkId   String
  label     String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([findingId, chunkId])
}

model RevisionSuggestion {
  id           String   @id @default(cuid())
  findingId    String
  proposedText String
  rationale    String
  finding      Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  review       Review?
  createdAt    DateTime @default(now())
}

model Review {
  id           String             @id @default(cuid())
  suggestionId String             @unique
  assigneeId   String?
  status       ReviewStatus       @default(DRAFT)
  revision     Int                @default(0)
  suggestion   RevisionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  comments     ReviewComment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  authorId  String
  body      String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
}

model Chunk {
  id                String                     @id @default(cuid())
  organizationId    String
  matterId          String
  documentId        String
  documentVersionId String
  ordinal           Int
  pageStart         Int
  pageEnd           Int
  text              String
  textChecksum      String
  embeddingModel    String
  embedding         Unsupported("vector(768)")
  documentVersion   DocumentVersion            @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime                   @default(now())

  @@unique([documentVersionId, ordinal])
  @@index([organizationId, matterId, documentId])
  @@index([textChecksum, embeddingModel])
}

model UploadReservation {
  id             String             @id @default(uuid())
  organizationId String
  matterId       String
  filename       String
  mediaType      String
  sizeBytes      Int
  sha256         String
  classification DataClassification
  objectKey      String             @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@index([organizationId, expiresAt])
}

model ProcessingJob {
  id                String          @id @default(cuid())
  documentVersionId String
  status            JobStatus       @default(QUEUED)
  attempts          Int             @default(0)
  availableAt       DateTime        @default(now())
  leaseOwner        String?
  leaseUntil        DateTime?
  errorCode         String?
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, availableAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  target         String
  targetId       String
  metadata       Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}
